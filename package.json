{
  "name": "apex",
  "productName": "Apex",
  "version": "0.5.0",
  "description": "Apex — registro de tomas y farmacocinética personal por sustancia. Dosis, hitos (onset, pico, fin), gráficos y mapa de calor.",
  "main": "main.cjs",
  "author": "Francisco Pavez",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/tokens.test.mjs && node test/store.test.mjs && node test/format.test.mjs && node test/pk.test.mjs",
    "humo": "electron test/humo.test.cjs",
    "icon": "electron build/make-icon.cjs",
    "build": "electron-builder --win --publish never",
    "test:paquete": "electron test/empaquetado.test.cjs",
    "release": "node tools/publicar.mjs"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.kiddshady.apex",
    "productName": "Apex",
    "copyright": "Copyright © 2026 Francisco Pavez",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!build/**",
      "build/icon.png",
      "!data/**",
      "!test/**",
      "!dist/**",
      "!docs/**",
      "!tools/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "kiddshady",
      "repo": "Apex"
    }
  }
}
